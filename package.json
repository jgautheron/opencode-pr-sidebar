{
  "name": "opencode-pr-sidebar",
  "version": "0.1.6",
  "description": "OpenCode TUI sidebar plugin that tracks GitHub pull requests mentioned in the current session.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgautheron/opencode-pr-sidebar.git"
  },
  "exports": {
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./src/tui.tsx"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun test src/*.test.ts && bun run build"
  },
  "engines": {
    "opencode": ">=1.15.10"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github",
    "pull-request",
    "tui"
  ],
  "dependencies": {
    "@opentui/core": "^0.2.15",
    "@opentui/solid": "^0.2.15",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.10",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3"
  }
}
